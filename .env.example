# Copy this file to .env. Never commit .env.

# 1 = canned Gemini answers, no key needed. Person 1 sets 0 once real calls exist.
MOCK_GEMINI=1

# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_FAST_MODEL=gemini-flash-lite-latest

# Zoom Meeting SDK app keys (Person 4). The app and the demo meeting must belong to the same Zoom account.
ZOOM_SDK_KEY=
ZOOM_SDK_SECRET=

# 1 = save every captured frame to the system temp folder (zoominsight-frames) to debug slide detection.
DEBUG_FRAMES=0

# Contact sent to browser push services with presenter notifications. Any mailto: or https: address you own.
# VAPID_SUBJECT=mailto:you@example.com

# Where uploaded decks are saved so they survive restarts. Default: a data folder in the project.
# DATA_DIR=./data

PORT=3000
